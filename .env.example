# Copy this file to .env.local and put your real key there.
# .env.local is ignored by git, so your key never gets committed.
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Hosted database (needed on Vercel). Leave empty locally to use the leads.db file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Groq API key for AI-written outreach messages (server-only).
# Get a free key from https://console.groq.com/keys
# Without it, the lead detail page falls back to a basic template.
GROQ_API_KEY=

# Optional Groq model override (default: openai/gpt-oss-120b).
# Use a model name from the Groq console, and change it if the default is retired.
GROQ_MODEL=
